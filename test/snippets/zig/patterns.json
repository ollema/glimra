{
  "language": "zig",
  "grammar_file": "zig.json",
  "pattern_count": 51,
  "patterns": [
    "\"",
    "$",
    "'([^'\\\\]|\\\\(x\\h{2}|[012][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.))'",
    "(-%?|\\+%?|\\*%?|[%/])=?",
    "(<<%?|>>|[!\\&^|~])=?",
    "(==|\\+\\+|\\*\\*|->)",
    "(?<=\\[)\\*c(?=])",
    "([A-Z][0-9A-Za-z]*)(?=\\s*\\()",
    "([A-Z_a-z][0-9A-Z_a-z]*)(?=\\s*\\()",
    ",",
    "//",
    "//[!/](?=[^/])",
    ":",
    ";",
    "=",
    "@\"",
    "@[A-Z_a-z][0-9A-Z_a-z]*",
    "\\.",
    "\\?",
    "\\\\([\"'\\\\nrt]|(x\\h{2})|(u\\{\\h+}))",
    "\\\\.",
    "\\\\\\\\",
    "\\b((and|or))\\b|(==|!=|<=|>=|[<>])",
    "\\b(TODO|FIXME|XXX|NOTE)\\b:?",
    "\\b(asm|unreachable)\\b",
    "\\b(bool|void|noreturn|type|error|anyerror|anyframe|anytype|anyopaque)\\b",
    "\\b(break|return|continue|defer|errdefer)\\b",
    "\\b(c_(?:char|short|ushort|int|uint|long|ulong|longlong|ulonglong|longdouble))\\b",
    "\\b(const|var|fn)\\b",
    "\\b(extern|packed|export|pub|noalias|inline|comptime|volatile|align|linksection|threadlocal|allowzero|noinline|callconv)\\b",
    "\\b(f16|f32|f64|f80|f128|u\\d+|i\\d+|isize|usize|comptime_int|comptime_float)\\b",
    "\\b(fn)\\s+([A-Z][0-9A-Za-z]*)\\b",
    "\\b(fn)\\s+([A-Z_a-z][0-9A-Z_a-z]*)\\b",
    "\\b(fn)\\s+@\"",
    "\\b(if|else|switch|orelse)\\b",
    "\\b(null|undefined)\\b",
    "\\b(resume|suspend|nosuspend)\\b",
    "\\b(struct|enum|union|opaque)\\b",
    "\\b(test|and|or)\\b",
    "\\b(true|false)\\b",
    "\\b(try|catch)\\b",
    "\\b(while|for)\\b",
    "\\b0b[01_]+\\b",
    "\\b0o[0-7_]+\\b",
    "\\b0x[_\\h]+\\b",
    "\\b0x\\h[_\\h]*(\\.\\h[_\\h]*)?([Pp][-+]?[_\\h]+)?\\b",
    "\\b[0-9](([EPep][-+])|[0-9A-Z_a-z])*(\\.(([EPep][-+])|[0-9A-Z_a-z])*)?([EPep][-+])?[0-9A-Z_a-z]*\\b",
    "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([Ee][-+]?[0-9_]+)?\\b",
    "\\b[0-9][0-9_]*\\b",
    "\\b[A-Z_a-z][0-9A-Z_a-z]*\\b",
    "\\binline\\b(?!\\s*\\bfn\\b)"
  ]
}
