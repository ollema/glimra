{
  "language": "diff",
  "grammar_file": "diff.json",
  "pattern_count": 16,
  "patterns": [
    "(^(\\+{3}) .+$\\n?| (-) .* (={4})$\\n?)",
    "\\n",
    "^(!).*$\\n?",
    "^(#)",
    "^((((-{3}) .+)|((\\*{3}) .+))$\\n?|(={4}) .+(?= - ))",
    "^(((-{3}) .+ (-{4}))|((\\*{3}) .+ (\\*{4})))$\\n?",
    "^(((<)( .*)?)|((-).*))$\\n?",
    "^(((>)( .*)?)|((\\+).*))$\\n?",
    "^((\\*{15})|(={67})|(-{3}))$\\n?",
    "^(@@)\\s*(.+?)\\s*(@@)($\\n?)?",
    "^Index(:) (.+)$\\n?",
    "^Only in .*: .*$\\n?",
    "^\\d+(,\\d+)*([acd])\\d+(,\\d+)*$\\n?",
    "^diff (-|\\S+\\s+\\S+).*$\\n?",
    "^diff --git a/.*$\\n?",
    "^index [0-9a-f]{7,40}\\.\\.[0-9a-f]{7,40}.*$\\n?"
  ]
}
